# Names only (RULES §3). Copy to .env and fill in. One host serves one network (API §0.3 N1, §5.1).
SHARK_NETWORK=testnet
TESTNET_RPC_URL=
TESTNET_CONTRACT_ID=
TESTNET_USDC_ID=
TESTNET_USDC_FAUCET_URL=
TESTNET_X402_FACILITATOR_URL=
TESTNET_X402_API_KEY=
# Indexer that lists calls to the contract (default NearBlocks, "off" disables the reader)
TESTNET_EVENTS_URL=
# NearBlocks API key: without it the keyless limit applies per IP, which shared hosts (Railway) run out of
TESTNET_EVENTS_KEY=
TESTNET_SHARK_ID=
# Shark's USDC wallet for escrow and keepers (until the OutLayer wallet)
TESTNET_SHARK_WALLET_ID=
# Raven payout gas gauge on /v1/company: the address that pays the gas (the company contract's address from Chain Signatures, path base-payouts, funded with Base Sepolia ETH).
# The Base Sepolia RPC defaults to https://sepolia.base.org; set TESTNET_EVM_RPC_URL only to use another one.
TESTNET_EVM_RPC_URL=
TESTNET_PAYOUT_EVM_ADDRESS=
# Agents (API 5.1) and the workers' RFQ endpoints
TESTNET_CRAB_ID=
TESTNET_CRAB_URL=
TESTNET_RAVEN_ID=
TESTNET_RAVEN_URL=
TESTNET_OWL_ID=
TESTNET_TREZU_URL=
# Secrets: never commit values
SHARK_QUOTE_KEY=
SHARK_FN_KEY=
SHARK_WALLET_KEY=
# Shared with Crab and Raven (same value in their env files): only calls that carry it are answered
SHARK_AGENT_TOKEN=
NEARAI_API_KEY=
# Optional
WEB_ORIGINS=
# Where agents reach this Shark (the x402 resource url)
PUBLIC_BASE_URL=
FILE_STORE_PATH=
RATE_LIMIT_PER_MIN=
# Seconds /v1/company, /v1/prices and /v1/health are kept in memory (default 10)
CACHE_SECS=
PORT=
