# Names only (RULES §3). Our own x402 facilitator for one network.
SHARK_NETWORK=testnet
TESTNET_RPC_URL=
TESTNET_CONTRACT_ID=
TESTNET_USDC_ID=
# The relayer pays gas and the 1 yocto for every settlement; keep it funded with a little NEAR
TESTNET_X402_RELAYER_ID=
PORT=
# Secrets: never commit values
# the relayer account's full-access key
X402_RELAYER_KEY=
# Shark sends this as X-API-Key
X402_API_KEY=
