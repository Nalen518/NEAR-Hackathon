{
  "name": "@shark/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "start:crab": "tsx --env-file-if-exists=.env.crab src/index.ts",
    "start:raven": "tsx --env-file-if-exists=.env.raven src/index.ts",
    "start:owl": "tsx --env-file-if-exists=.env.owl src/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@shark/checks": "workspace:*",
    "@shark/shared": "workspace:*",
    "hono": "4.13.13",
    "near-api-js": "7.3.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
