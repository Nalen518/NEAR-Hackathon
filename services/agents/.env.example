# Names only (RULES §3). One process per agent: AGENT_ROLE=crab, raven or owl.
AGENT_ROLE=
SHARK_NETWORK=testnet
TESTNET_RPC_URL=
TESTNET_CONTRACT_ID=
# Shark's base URL, e.g. https://<shark-host>/v1
TESTNET_API_URL=
TESTNET_CRAB_ID=
TESTNET_RAVEN_ID=
TESTNET_OWL_ID=
CRAB_MODEL=
RAVEN_MODEL=
OWL_MODEL=
# a different model, for the second review of a dispute
OWL_MODEL_SECONDARY=
NEARAI_BASE_URL=
PORT=
# Secrets: never commit values
# Shark's shared secret for the workers (Crab and Raven only; the same value as in Shark's env file)
SHARK_AGENT_TOKEN=
CRAB_KEY=
RAVEN_KEY=
OWL_KEY=
NEARAI_API_KEY=
