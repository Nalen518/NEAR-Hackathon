{
  "brief": {
    "jobType": "extract",
    "params": {
      "schema": {
        "fields": [
          {
            "name": "link",
            "type": "url",
            "required": true
          },
          {
            "name": "kind",
            "type": "enum",
            "required": true,
            "values": [
              "a",
              "b"
            ]
          }
        ]
      },
      "many": true,
      "maxRecords": 3
    },
    "checklist": [
      {
        "id": "C1",
        "kind": "code",
        "rule": "json_parses"
      },
      {
        "id": "C2",
        "kind": "code",
        "rule": "matches_schema"
      },
      {
        "id": "C3",
        "kind": "code",
        "rule": "required_fields_filled"
      },
      {
        "id": "C4",
        "kind": "code",
        "rule": "traceable >= 90%"
      },
      {
        "id": "C5",
        "kind": "code",
        "rule": "records <= 3"
      },
      {
        "id": "M1",
        "kind": "model",
        "rule": "no invented records"
      }
    ],
    "deliverableFormat": "application/json"
  },
  "source": "https://example.com/x a",
  "delivery": "[{\"link\":\"https://example.com/x\",\"kind\":\"a\"},{\"link\":\"ftp://nope\",\"kind\":\"c\"}]",
  "expected": {
    "checks": [
      {
        "id": "C1",
        "pass": true,
        "detail": "valid JSON"
      },
      {
        "id": "C2",
        "pass": false,
        "detail": "1 record off schema",
        "code": "FAIL_SCHEMA"
      },
      {
        "id": "C3",
        "pass": true,
        "detail": "all filled"
      },
      {
        "id": "C4",
        "pass": false,
        "detail": "75% found",
        "code": "FAIL_TRACEABILITY"
      },
      {
        "id": "C5",
        "pass": true,
        "detail": "2 records"
      }
    ],
    "codes": [
      "FAIL_SCHEMA",
      "FAIL_TRACEABILITY"
    ]
  }
}
