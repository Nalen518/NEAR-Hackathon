{
  "brief": {
    "jobType": "extract",
    "params": {
      "schema": {
        "fields": [
          {
            "name": "name",
            "type": "string",
            "required": true
          },
          {
            "name": "price",
            "type": "number",
            "required": true
          },
          {
            "name": "date",
            "type": "date",
            "required": false
          }
        ]
      },
      "many": true,
      "maxRecords": 3
    },
    "checklist": [
      {
        "id": "C1",
        "kind": "code",
        "rule": "json_parses"
      },
      {
        "id": "C2",
        "kind": "code",
        "rule": "matches_schema"
      },
      {
        "id": "C3",
        "kind": "code",
        "rule": "required_fields_filled"
      },
      {
        "id": "C4",
        "kind": "code",
        "rule": "traceable >= 90%"
      },
      {
        "id": "C5",
        "kind": "code",
        "rule": "records <= 3"
      },
      {
        "id": "M1",
        "kind": "model",
        "rule": "no invented records"
      }
    ],
    "deliverableFormat": "application/json"
  },
  "source": "Our catalogue: Blue Mug costs 12.50 since 2026-10-01. Red Plate costs 1,200 since 2026-09-15.",
  "delivery": "[{\"name\":\"Blue Mug\",\"price\":\"12.50\"},{\"name\":\"\",\"price\":3},{\"name\":\"Green Bowl\",\"price\":99},{\"name\":\"Red Plate\",\"price\":1200,\"colour\":\"red\"}]",
  "expected": {
    "checks": [
      {
        "id": "C1",
        "pass": true,
        "detail": "valid JSON"
      },
      {
        "id": "C2",
        "pass": false,
        "detail": "2 records off schema",
        "code": "FAIL_SCHEMA"
      },
      {
        "id": "C3",
        "pass": false,
        "detail": "1 record missing",
        "code": "FAIL_SCHEMA"
      },
      {
        "id": "C4",
        "pass": false,
        "detail": "62% found",
        "code": "FAIL_TRACEABILITY"
      },
      {
        "id": "C5",
        "pass": false,
        "detail": "4 records",
        "code": "FAIL_LENGTH"
      }
    ],
    "codes": [
      "FAIL_SCHEMA",
      "FAIL_TRACEABILITY",
      "FAIL_LENGTH"
    ]
  }
}
