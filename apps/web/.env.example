# Names only (RULES §3). Copy to .env.local and fill in. Names follow API-CONTRACT §5.1 (NEXT_PUBLIC_<NET>_*).
NEXT_PUBLIC_DEFAULT_NETWORK=testnet
# mock = fixtures from packages/shared (always labelled Sample); live = the Shark API below
NEXT_PUBLIC_API_MODE=mock

# Testnet profile. API_URL is Shark's origin, for example http://localhost:8787 (a trailing /v1 also works)
NEXT_PUBLIC_TESTNET_NETWORK_ID=
NEXT_PUBLIC_TESTNET_API_URL=
NEXT_PUBLIC_TESTNET_RPC_URL=
NEXT_PUBLIC_TESTNET_EXPLORER_URL=
NEXT_PUBLIC_TESTNET_EVM_EXPLORER_URL=
NEXT_PUBLIC_TESTNET_CONTRACT_ID=
NEXT_PUBLIC_TESTNET_USDC_ID=
NEXT_PUBLIC_TESTNET_USDC_FAUCET_URL=
NEXT_PUBLIC_TESTNET_WALLETS=

# Mainnet profile
NEXT_PUBLIC_MAINNET_NETWORK_ID=
NEXT_PUBLIC_MAINNET_API_URL=
NEXT_PUBLIC_MAINNET_RPC_URL=
NEXT_PUBLIC_MAINNET_EXPLORER_URL=
NEXT_PUBLIC_MAINNET_EVM_EXPLORER_URL=
NEXT_PUBLIC_MAINNET_CONTRACT_ID=
NEXT_PUBLIC_MAINNET_USDC_ID=
NEXT_PUBLIC_MAINNET_WALLETS=

# JSON array of mainnet proofs for the hero. kind: payment | worker-near | worker-base | review | refund | intents
# [{"kind":"intents","label":"Paid 0.60 USDC from Base","href":"https://…"}]
NEXT_PUBLIC_PROOF_LINKS=
# Footer links; a link is hidden while its variable is empty (repo stays private until 14 Nov)
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_BRAND_URL=
