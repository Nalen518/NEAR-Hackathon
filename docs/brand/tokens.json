{
  "$description": "Shark & Co. design tokens v2.0 (zero employee agency). Light 'paper' theme. Contrast ratios are computed (WCAG 2.1) against bg #F5F6F8 unless noted.",
  "color": {
    "bg": {
      "value": "#F5F6F8",
      "note": "page, cool paper (never pure white)"
    },
    "surface": {
      "value": "#FCFCFD",
      "note": "cards, panes"
    },
    "surface-2": {
      "value": "#ECEEF2",
      "note": "raised / hover"
    },
    "tile": {
      "value": "#E9EDF2",
      "note": "mascot avatar tile"
    },
    "line": {
      "value": "#DADDE3",
      "note": "hairlines, 1px borders"
    },
    "line-strong": {
      "value": "#B5BAC4",
      "note": "input borders, dividers (non-text)"
    },
    "ink": {
      "value": "#161A22",
      "contrast": 16.12,
      "note": "text + every illustration outline (never #000)"
    },
    "muted": {
      "value": "#5A606C",
      "contrast": 5.84,
      "note": "secondary text"
    },
    "faint": {
      "value": "#8B919C",
      "contrast": 2.93,
      "note": "placeholders, mono micro-labels >= 12px caps only; never body text"
    },
    "accent": {
      "value": "#2B59FF",
      "contrast": 4.88,
      "note": "'Sonar' brand accent: CTA fill (white text 5.15), links, focus ring, Owl pass, Shark's tie. <5% of any screen"
    },
    "gain": {
      "value": "#147A44",
      "contrast": 4.98,
      "note": "MONEY MOVING IN only: payouts, refunds received, reserve gains. White text on it 5.26"
    },
    "loss": {
      "value": "#C2362B",
      "contrast": 5.04,
      "note": "MONEY MOVING OUT only: refunds sent, losses. White text on it 5.31. Strikes, cage, review fails use ink or accent"
    }
  },
  "character": {
    "shark": {
      "body": "#6E8BA8",
      "belly": "#EEF2F6",
      "prop": "accent necktie"
    },
    "owl": {
      "body": "#A86B32",
      "face": "#F3E3C8",
      "belly": "#E3C49A",
      "beak": "#E9A23B",
      "prop": "thick round glasses (reviews every job in an OutLayer TEE, paid on NEAR)"
    },
    "fish": {
      "body": "#F2B33D",
      "belly": "#FBE3A6",
      "prop": "hook + fishing line",
      "note": "fill only; 1.72:1 on bg, the ink outline carries the shape"
    },
    "raven": {
      "body": "#5E5A86",
      "belly": "#B3AFD6",
      "beak": "#2F2B45",
      "pouch": "#D8B46A",
      "prop": "coin pouch with a chain link (worker, paid on Base via Chain Signatures)"
    },
    "crab": {
      "body": "#E07A5F",
      "belly": "#EFA08A",
      "prop": "tiny laptop (worker, paid on NEAR)",
      "note": "D-167"
    }
  },
  "font": {
    "display": {
      "family": "Schibsted Grotesk",
      "weights": [
        600,
        800
      ],
      "use": "headlines, verdict word"
    },
    "mono": {
      "family": "IBM Plex Mono",
      "weights": [
        400,
        500,
        600
      ],
      "use": "all numbers (tabular-nums), tickers, tx hashes, // micro-labels"
    },
    "hand": {
      "family": "Patrick Hand",
      "weights": [
        400
      ],
      "use": "eyebrow line + the one-line roast only"
    }
  },
  "radius": {
    "sm": 4,
    "md": 10,
    "pane": 22,
    "pill": 999
  },
  "motion": {
    "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "hero-line-stagger-ms": 100,
    "cage-drop-ms": 420,
    "note": "everything off under prefers-reduced-motion; state never lives only in motion",
    "ease-quart": "cubic-bezier(0.25, 1, 0.5, 1)",
    "fast_ms": 180,
    "base_ms": 280,
    "slow_ms": 600,
    "stagger_ms": 120
  }
}
